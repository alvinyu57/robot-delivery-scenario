<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find delivery_robot_description)/models/delivery_robot/common_inertia.xacro"/>

  <xacro:macro name="base_xacro" params="length radius">
    <link name="base_footprint"/>

    <link name="base_link">
      <visual>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="blue">
          <color rgba="0.05 0.22 0.75 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="1.5" r="${radius}" h="${length}"/>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
    </joint>

    <link name="parcel_link">
      <visual>
        <geometry>
          <box size="0.46 0.38 0.28"/>
        </geometry>
        <material name="parcel_brown">
          <color rgba="0.70 0.38 0.12 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.46 0.38 0.28"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="1.0" w="0.46" h="0.38" d="0.28"/>
    </link>

    <joint name="parcel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="parcel_link"/>
      <origin xyz="-0.08 0 0.30" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
