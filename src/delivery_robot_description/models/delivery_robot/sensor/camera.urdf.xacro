<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find delivery_robot_description)/models/delivery_robot/common_inertia.xacro" />

    <xacro:macro name="rgbd_camera_xacro" params="xyz">
        <link name="rgbd_camera_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.12 0.20 0.10"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.12 0.20 0.10"/>
                </geometry>
            </collision>
            <xacro:box_inertia m="0.2" w="0.12" h="0.20" d="0.10"/>
        </link>

        <link name="rgbd_camera_optical_link"/>

        <joint name="rgbd_camera_joint" type="fixed">
            <parent link="base_link"/>
            <child link="rgbd_camera_link"/>
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
        </joint>
        <joint name="rgbd_camera_optical_joint" type="fixed">
            <parent link="rgbd_camera_link"/>
            <child link="rgbd_camera_optical_link"/>
            <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
        </joint>
    </xacro:macro>
</robot>
