<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="traffic_police_base">
    <link name="police_base">
      <visual name="left_leg">
        <origin xyz="0 0.13 0.40" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.80"/>
        </geometry>
        <material name="dark_blue">
          <color rgba="0.03 0.08 0.24 1"/>
        </material>
      </visual>

      <visual name="right_leg">
        <origin xyz="0 -0.13 0.40" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.10" length="0.80"/>
        </geometry>
        <material name="dark_blue"/>
      </visual>

      <visual name="uniform">
        <origin xyz="0 0 1.08" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.28" length="0.72"/>
        </geometry>
        <material name="police_blue">
          <color rgba="0.02 0.18 0.58 1"/>
        </material>
      </visual>

      <visual name="reflective_band">
        <origin xyz="0 0 1.15" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.285" length="0.10"/>
        </geometry>
        <material name="reflective_yellow">
          <color rgba="1.00 0.95 0.15 1"/>
        </material>
      </visual>

      <visual name="left_arm">
        <origin xyz="0 0.34 1.08" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.62"/>
        </geometry>
        <material name="police_blue"/>
      </visual>

      <visual name="right_arm">
        <origin xyz="0 -0.34 1.08" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.62"/>
        </geometry>
        <material name="police_blue"/>
      </visual>

      <visual name="head">
        <origin xyz="0 0 1.62" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.22"/>
        </geometry>
        <material name="skin">
          <color rgba="0.82 0.60 0.40 1"/>
        </material>
      </visual>

      <visual name="face_direction">
        <origin xyz="0.205 0 1.63" rpy="0 1.570796 0"/>
        <geometry>
          <cylinder radius="0.045" length="0.03"/>
        </geometry>
        <material name="face_dark">
          <color rgba="0.12 0.08 0.05 1"/>
        </material>
      </visual>

      <visual name="cap">
        <origin xyz="0 0 1.82" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.25" length="0.09"/>
        </geometry>
        <material name="cap_blue">
          <color rgba="0.02 0.10 0.38 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.90" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.28" length="1.80"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.90" rpy="0 0 0"/>
        <mass value="70.0"/>
        <inertia ixx="19.84" ixy="0" ixz="0"
                 iyy="19.84" iyz="0" izz="2.744"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>
