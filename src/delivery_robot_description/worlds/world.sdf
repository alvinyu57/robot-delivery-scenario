<?xml version="1.0"?>
<sdf version="1.10">
  <world name="delivery_scenario">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.78 0.86 0.95 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="environment">
      <static>true</static>

      <link name="ground">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 30 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 30 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.16 0.32 0.12 1</ambient>
            <diffuse>0.20 0.40 0.16 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="north_approach_wall">
        <pose>-3.95 2.10 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>12.10 0.20 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.10 0.20 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.65 1</ambient>
            <diffuse>0.78 0.76 0.70 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="west_start_wall">
        <pose>-10.0 0 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 4.20 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 4.20 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.65 1</ambient>
            <diffuse>0.78 0.76 0.70 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="south_approach_wall">
        <!-- The rising inner wall makes the street narrower at the corner. -->
        <pose>-6.05 -1.05 1.0 0 0 0.2598</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>8.17 0.20 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.17 0.20 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.65 1</ambient>
            <diffuse>0.78 0.76 0.70 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="west_destination_wall">
        <pose>-2.10 -4.55 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 9.10 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 9.10 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.65 1</ambient>
            <diffuse>0.78 0.76 0.70 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="east_destination_wall">
        <pose>2.10 -3.50 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 11.20 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 11.20 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.62 0.60 0.56 1</ambient>
            <diffuse>0.70 0.68 0.62 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="end_wall">
        <pose>0 -9.10 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>4.4 0.20 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4.4 0.20 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.65 1</ambient>
            <diffuse>0.78 0.76 0.70 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_near_b">
        <pose>1.45 -6.55 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.30 0.20 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.30 0.20 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.65 1</ambient>
            <diffuse>0.78 0.76 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="delivery_area_b">
      <static>true</static>
      <pose>1.25 -7.8 0 0 0 0</pose>
      <link name="delivery_area">
        <visual name="marker">
          <pose>0 0 0.06 0 0 0</pose>
          <geometry>
            <box>
              <size>1.20 1.20 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.75 0.15 1</ambient>
            <diffuse>0.10 0.90 0.20 1</diffuse>
            <emissive>0.02 0.15 0.03 1</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
